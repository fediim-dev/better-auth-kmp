{
  "fediim-safety-gates": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/pre-bash.cjs",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/pre-write.cjs",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/pre-read.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node hooks/pre-invocation.cjs",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node hooks/tdd-stop.cjs",
        "timeout": 45
      },
      {
        "type": "command",
        "command": "node ../.fediim/tools/telemetry.mjs stop --runtime antigravity",
        "timeout": 5
      }
    ]
  }
}
