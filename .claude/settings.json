{
  "fallbackModel": [
    "claude-sonnet-5-5"
  ],
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "65",
    "ENABLE_TOOL_SEARCH": "auto:5",
    "CI": "1",
    "FEDIIM_AUTONOMOUS_LOCAL": "1",
    "GH_PROMPT_DISABLED": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "NPM_CONFIG_YES": "true",
    "PAGER": "cat",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_TRACES_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_METRICS_EXPORTER": "none",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT": "http://ntcserver-macmini:6006/v1/traces",
    "OTEL_RESOURCE_ATTRIBUTES": "fediim.version=0.7.2,fediim.packs=6e29c60ce246,fediim.preset=custom,fediim.experimental=none,fediim.project=better-auth-kmp,openinference.project.name=better-auth-kmp,service.name=fediim,service.version=0.7.2,fediim.autonomy=autonomous,fediim.stacks=kmp+kotlin"
  },
  "sandbox": {
    "enabled": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash.cjs",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-write.cjs",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-read.cjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compact-rehydrate.cjs",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/compact-rehydrate.cjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tdd-stop.cjs",
            "timeout": 45
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.fediim/tools/telemetry.mjs stop --runtime claude",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Grep(**)",
      "Edit(**)",
      "Bash(node .fediim/tools/recall.mjs)",
      "Bash(node .fediim/tools/recall.mjs *)",
      "Bash(node .fediim/tools/guard-mutation.mjs)",
      "Bash(node .fediim/tools/guard-mutation.mjs *)",
      "Bash(node .fediim/tools/brief.mjs)",
      "Bash(node .fediim/tools/brief.mjs *)",
      "Bash(node .fediim/tools/review-package.mjs)",
      "Bash(node .fediim/tools/review-package.mjs *)",
      "Bash(node .fediim/tools/pr-prep.mjs)",
      "Bash(node .fediim/tools/pr-prep.mjs *)",
      "Bash(node .fediim/tools/affected-tests.mjs)",
      "Bash(node .fediim/tools/affected-tests.mjs *)",
      "Bash(node .fediim/tools/outline.mjs)",
      "Bash(node .fediim/tools/outline.mjs *)",
